@page "/register"
@attribute [Authorize]
@inject HttpClient Http
@inject LocalizationService Loc
@implements IDisposable

<PageTitle>@Loc.RegistrationPageTitle</PageTitle>

<div class="pastel-page">
    <div class="pastel-container">
        <h1>@Loc.RegistrationPageTitle</h1>

        <div class="pastel-card">
            @if (!string.IsNullOrEmpty(_message))
            {
                <p class="@(_isError ? "message-error" : "message-success")">@_message</p>
            }
            
            <label class="pastel-field">
                @Loc.ProfileName
                <input placeholder="" @bind="_profilName" @bind:event="oninput"/>
            </label>
            
            <label class="pastel-field">
                @Loc.FirstNamePlaceholder
                <input placeholder="@Loc.FirstNamePlaceholder" @bind="_firstName" @bind:event="oninput" />
            </label>

            <label class="pastel-field">
                @Loc.LastNamePlaceholder
                <input placeholder="@Loc.LastNamePlaceholder" @bind="_lastName" @bind:event="oninput" />
            </label>

            <label class="pastel-field">
                @Loc.DateOfBirthPlaceholder
                <input type="date" @bind="_dateOfBirth" />
            </label>

            <label class="pastel-field">
                @Loc.GenderPlaceholder
                <select @bind="_gender" aria-label="@Loc.GenderPlaceholder">
                    @foreach (var gender in Enum.GetValues<Gender>())
                    {
                        <option value="@gender">@Loc.GenderName(gender)</option>
                    }
                </select>
            </label>

            <fieldset class="pastel-checkbox-group">
                <legend>@Loc.InterestedInPlaceholder</legend>
                @foreach (var interest in InterestOptions)
                {
                    <label>
                        <input type="checkbox" checked="@_interestedIn.Contains(interest)"
                               @onchange="@(e => ToggleInterest(interest, (bool)e.Value!))" />
                        @Loc.InterestName(interest)
                    </label>
                }
            </fieldset>

            <fieldset class="pastel-checkbox-group">
                <legend>@Loc.AgeRangePlaceholder</legend>
                <div class="pastel-range-slider">
                    <div class="pastel-range-values">
                        <span>@_minAgeInterest @Loc.YearsUnitLabel</span>
                        <span>@_maxAgeInterest @Loc.YearsUnitLabel</span>
                    </div>
                    <div class="pastel-range-track">
                        <div class="pastel-range-fill" style="left: @(MinAgePercent)%; right: @(100 - MaxAgePercent)%"></div>
                        <input type="range" min="@MinPossibleAge" max="@MaxPossibleAge" value="@_minAgeInterest"
                               @oninput="OnMinAgeInput" aria-label="@Loc.AgeRangeFromLabel" />
                        <input type="range" min="@MinPossibleAge" max="@MaxPossibleAge" value="@_maxAgeInterest"
                               @oninput="OnMaxAgeInput" aria-label="@Loc.AgeRangeToLabel" />
                    </div>
                </div>
            </fieldset>

            <button class="cta-primary" @onclick="OnRegisterNowClicked">@Loc.RegisterNowButtonText</button>
        </div>
    </div>
</div>

@code {
    private string _profilName = string.Empty;
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private DateTime? _dateOfBirth;
    private Gender _gender = Gender.Male;
    private readonly HashSet<GenderInterest> _interestedIn = [];
    private const int MinPossibleAge = 18;
    private const int MaxPossibleAge = 99;

    private int _minAgeInterest = MinPossibleAge;
    private int _maxAgeInterest = MaxPossibleAge;
    private string? _message;
    private bool _isError;

    private static readonly GenderInterest[] InterestOptions =
        [GenderInterest.Male, GenderInterest.Female, GenderInterest.Diverse];

    private double MinAgePercent => (_minAgeInterest - MinPossibleAge) * 100.0 / (MaxPossibleAge - MinPossibleAge);
    private double MaxAgePercent => (_maxAgeInterest - MinPossibleAge) * 100.0 / (MaxPossibleAge - MinPossibleAge);

    private void OnMinAgeInput(ChangeEventArgs e)
    {
        _minAgeInterest = Math.Min(Convert.ToInt32(e.Value), _maxAgeInterest);
    }

    private void OnMaxAgeInput(ChangeEventArgs e)
    {
        _maxAgeInterest = Math.Max(Convert.ToInt32(e.Value), _minAgeInterest);
    }

    private void ToggleInterest(GenderInterest interest, bool isChecked)
    {
        if (isChecked)
            _interestedIn.Add(interest);
        else
            _interestedIn.Remove(interest);
    }

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }

    private async Task OnRegisterNowClicked()
    {
        var interestedIn = _interestedIn.Aggregate(GenderInterest.None, (acc, interest) => acc | interest);

        var response = await Http.PostAsJsonAsync("api/users/register", new RegisterRequest(
            _firstName.Trim(), _lastName.Trim(), _dateOfBirth!.Value, _gender, interestedIn, _minAgeInterest, _maxAgeInterest));

        var result = await response.Content.ReadFromJsonAsync<RegisterResponse>();

        _isError = result?.Success != true;
        _message = _isError ? null : Loc.RegistrationSuccessMessage;
    }
}
