@page "/profile"
@attribute [Authorize]
@using System.Security.Claims
@inject HttpClient Http

<PageTitle>Profile</PageTitle>

<div class="pastel-page">
    <div class="pastel-container">
        <h1>Profile</h1>

        <AuthorizeView>
            <Authorized>
                <div class="pastel-card">
                    <p><strong>Name:</strong> @context.User.Identity?.Name</p>
                    <p><strong>Email:</strong> @context.User.FindFirst(ClaimTypes.Email)?.Value</p>

                    @if (_profileInfo is not null)
                    {
                        <h2>Profil Daten</h2>
                        <p><strong>Vorname:</strong> @_profileInfo.FirstName</p>
                        <p><strong>Nachname:</strong> @_profileInfo.LastName</p>
                        <p><strong>Geburtsdatum:</strong> @_profileInfo.DateOfBirth</p>
                        <p><strong>Geschlecht</strong> @_profileInfo.Gender</p>
                        <p><strong>Interresiert an:</strong> @_profileInfo.InterestedIn</p>
                        <p><strong>Altersrange: </strong> @_profileInfo.MinAgeInterest</p>
                        <p><strong> Altersobergrenze:</strong> @_profileInfo.MaxAgeInterest</p>
                        
                                
                    }
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private UserProfileResponse? _profileInfo;

    protected override async Task OnInitializedAsync()
    {
        _profileInfo = await Http.GetFromJsonAsync<UserProfileResponse>("api/users/me");
    }
}
